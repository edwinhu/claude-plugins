{
  "hook": "ds-reviewer-readonly-guard",
  "cases": [
    {
      "name": "read-is-untouched",
      "kind": "allow",
      "stdin": { "tool_name": "Read", "tool_input": { "file_path": "src/app.py" } }
    },
    {
      "name": "planning-sentinel-write-allowed",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": ".planning/SPEC_REVIEWED.md" } }
    },
    {
      "name": "write-to-source-denied",
      "kind": "deny",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "src/app.py" } }
    },
    {
      "name": "edit-to-source-denied",
      "kind": "deny",
      "stdin": { "tool_name": "Edit", "tool_input": { "file_path": "analysis/model.R" } }
    }
  ]
}
