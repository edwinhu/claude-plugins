{
  "hook": "lint-check",
  "cases": [
    {
      "name": "context-ruff-reports-violations",
      "kind": "context",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "bad.py"
        }
      },
      "fixture": {
        "bad.py": "import os\n\n\nx = 1\n"
      },
      "tsExpected": {
        "stdoutSha256": "9d268891ebc48bd7f8f50b3f1ad493456663ad570618bd43622152b02b7303a6",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "context-ruff-errors-on-missing-file",
      "kind": "context",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "gone.py"
        }
      },
      "fixture": {
        "placeholder.txt": "the .py named in tool_input is deliberately absent; ruff exits nonzero with E902\n"
      },
      "tsExpected": {
        "stdoutSha256": "5e65da5b41f2cf7f2cf465722cb608550cefe1b4354e3939749e28e3236559aa",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "allow-clean-python-file",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "clean.py"
        }
      },
      "fixture": {
        "clean.py": "x = 1\n"
      },
      "tsExpected": {
        "stdoutSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "allow-marimo-notebook-routed-away-from-ruff",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "notebook.py"
        }
      },
      "fixture": {
        "notebook.py": "import marimo\n\napp = marimo.App()\n\nimport os\nimport sys\n"
      },
      "tsExpected": {
        "stdoutSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "allow-non-edit-tool",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Read",
        "tool_input": {
          "file_path": "bad.py"
        }
      },
      "fixture": {
        "bad.py": "import os\n\n\nx = 1\n"
      },
      "tsExpected": {
        "stdoutSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "allow-missing-file-path",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "tool_input": {}
      },
      "fixture": {
        "bad.py": "import os\n\n\nx = 1\n"
      },
      "tsExpected": {
        "stdoutSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "allow-unsupported-extension",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "notes.md"
        }
      },
      "fixture": {
        "notes.md": "# notes\n\nimport os\n"
      },
      "tsExpected": {
        "stdoutSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "exit": 0,
        "fs": {}
      }
    },
    {
      "name": "allow-js-routed-to-eslint-not-ruff",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "app.js"
        }
      },
      "fixture": {
        "app.js": "var x = 1\n"
      },
      "tsExpected": {
        "stdoutSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "exit": 0,
