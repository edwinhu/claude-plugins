{
  "hook": "wc-constraint-check",
  "cases": [
    {
      "name": "malformed-stdin-exits-silently",
      "kind": "allow",
      "stdin": "this is not json"
    },
    {
      "name": "empty-payload-no-tool-name",
      "kind": "allow",
      "stdin": {}
    },
    {
      "name": "read-tool-ignored-even-on-wc-path",
      "kind": "allow",
      "stdin": { "tool_name": "Read", "tool_input": { "file_path": "skills/workflow-creator/SKILL.md" } }
    },
    {
      "name": "write-without-file-path-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": {} }
    },
    {
      "name": "write-to-unrelated-skill-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "skills/writing/SKILL.md" } }
    },
    {
      "name": "write-to-wc-skill-runs-constraint-suite",
      "kind": "effect",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "skills/workflow-creator/phases/01-interview.md" } }
    },
    {
      "name": "edit-to-wc-constraint-file-runs-constraint-suite",
      "kind": "effect",
      "stdin": { "tool_name": "Edit", "tool_input": { "file_path": "references/constraints/wc-traceability.md" } }
    },
    {
      "name": "absolute-wc-path-matches-by-substring",
      "kind": "effect",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "/home/eh/projects/workflows/skills/workflow-creator/SKILL.md" } }
    }
  ]
}
