{
  "hook": "ds-read-after-subagent-guard",
  "_notes": [
    "The guard's only state is a flag file at <tempdir>/ds-workflow-flags/subagent-returned-<CLAUDE_SESSION_ID>,",
    "where <tempdir> is Python's tempfile.gettempdir(). Every case therefore sets TMPDIR='.' so the flag",
    "directory resolves INSIDE the parity sandbox cwd and can be supplied as a fixture. Python's",
    "gettempdir() returns '.' verbatim for TMPDIR='.' (os.curdir is exempted from abspath), so the flag path",
    "is './ds-workflow-flags/subagent-returned-<session>'. A TS port must reproduce that resolution order",
    "(TMPDIR, TEMP, TMP, then the platform default) or the deny branch becomes unreachable and silently allows.",
    "CLAUDE_SESSION_ID is pinned in every case because the harness inherits the real session's value."
  ],
  "cases": [
    {
      "name": "allow-no-flag-file",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": { "file_path": "src/analysis.py" }
      },
      "env": { "TMPDIR": ".", "CLAUDE_SESSION_ID": "parity-no-flag" },
      "fixture": {
        "src/analysis.py": "import polars as pl\n"
      }
    },
    {
      "name": "allow-flag-set-but-tool-carries-no-path",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "cat src/analysis.py" }
      },
      "env": { "TMPDIR": ".", "CLAUDE_SESSION_ID": "parity-session" },
      "fixture": {
        "ds-workflow-flags/subagent-returned-parity-session": "",
        "src/analysis.py": "import polars as pl\n"
      }
    },
    {
      "name": "allow-flag-set-read-of-planning-state",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": { "file_path": ".planning/SPEC.md" }
      },
      "env": { "TMPDIR": ".", "CLAUDE_SESSION_ID": "parity-session" },
      "fixture": {
        "ds-workflow-flags/subagent-returned-parity-session": "",
        ".planning/SPEC.md": "# Spec\n"
      }
    },
    {
      "name": "allow-flag-set-glob-under-allowed-pattern",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Glob",
        "tool_input": { "pattern": "*.md", "path": "docs/CLAUDE.md" }
      },
      "env": { "TMPDIR": ".", "CLAUDE_SESSION_ID": "parity-session" },
      "fixture": {
        "ds-workflow-flags/subagent-returned-parity-session": "",
        "docs/CLAUDE.md": "# project\n"
      }
    },
    {
      "name": "deny-flag-set-read-of-source-file",
      "kind": "deny",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": { "file_path": "src/analysis.py" }
      },
      "env": { "TMPDIR": ".", "CLAUDE_SESSION_ID": "parity-session" },
      "fixture": {
        "ds-workflow-flags/subagent-returned-parity-session": "",
        "src/analysis.py": "import polars as pl\n"
      }
    },
    {
      "name": "deny-flag-set-grep-of-data-dir",
      "kind": "deny",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": { "pattern": "permno", "path": "data/raw" }
      },
      "env": { "TMPDIR": ".", "CLAUDE_SESSION_ID": "parity-session" },
      "fixture": {
        "ds-workflow-flags/subagent-returned-parity-session": "",
        "data/raw/panel.csv": "permno,ret\n10001,0.01\n"
      }
    }
  ]
}
