{
  "hook": "atomic-constraint-guard",
  "cases": [
    {
      "name": "non-write-tool-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Read", "tool_input": { "file_path": "references/foo-constraints.md" } },
      "fixture": {
        "references/foo-constraints.md": "### One\ntext\n### Two\ntext\n### Three\ntext\n"
      }
    },
    {
      "name": "missing-file-path-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": {} }
    },
    {
      "name": "non-md-suffix-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/foo-constraints.py" } },
      "fixture": {
        "references/foo-constraints.py": "### One\n### Two\n### Three\n"
      }
    },
    {
      "name": "md-outside-references-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "docs/foo-constraints.md" } },
      "fixture": {
        "docs/foo-constraints.md": "### One\ntext\n### Two\ntext\n### Three\ntext\n"
      }
    },
    {
      "name": "unreadable-missing-file-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/gone-constraints.md" } }
    },
    {
      "name": "references-stem-not-constraintlike-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/edgar.md" } },
      "fixture": {
        "references/edgar.md": "### One\ntext\n### Two\ntext\n### Three\ntext\n"
      }
    },
    {
      "name": "references-constraints-stem-but-only-two-h3-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/style-constraints.md" } },
      "fixture": {
        "references/style-constraints.md": "### One\ntext\n### Two\ntext\n"
      }
    },
    {
      "name": "monolith-detected-constraints-stem-in-references",
      "kind": "context",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/style-constraints.md" } },
      "fixture": {
        "references/style-constraints.md": "# Style\n\n### Rule one\ntext\n\n### Rule two\ntext\n\n### Rule three\ntext\n"
      }
    },
    {
      "name": "monolith-detected-conventions-stem-nested-references",
      "kind": "context",
      "stdin": { "tool_name": "Edit", "tool_input": { "file_path": "skills/writing/references/prose-conventions.md" } },
      "fixture": {
        "skills/writing/references/prose-conventions.md": "### A\nx\n### B\nx\n### C\nx\n### D\nx\n"
      }
    },
    {
      "name": "potential-monolith-in-constraints-dir",
      "kind": "context",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/constraints/no-emoji.md" } },
      "fixture": {
        "references/constraints/no-emoji.md": "### Rule\ntext\n### Rationale\ntext\n### Examples\ntext\n"
      }
    },
    {
      "name": "constraints-dir-two-h3-ignored",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/constraints/no-emoji.md" } },
      "fixture": {
        "references/constraints/no-emoji.md": "### Rule\ntext\n### Rationale\ntext\n"
      }
    },
    {
      "name": "atomic-constraints-meta-file-exempt",
      "kind": "allow",
      "stdin": { "tool_name": "Write", "tool_input": { "file_path": "references/constraints/atomic-constraints.md" } },
      "fixture": {
        "references/constraints/atomic-constraints.md": "### Rule\ntext\n### Rationale\ntext\n### Examples\ntext\n"
      }
    },
    {
      "name": "empty-payload-ignored",
      "kind": "allow",
      "stdin": {}
    }
  ]
}
