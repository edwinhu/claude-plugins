{
  "hook": "ds-no-main-chat-code-guard",
  "cases": [
    {
      "name": "allow-non-guarded-tool",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": { "file_path": "src/analysis.py" }
      }
    },
    {
      "name": "allow-bash-safe-prefix-git",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "  git status --short" }
      }
    },
    {
      "name": "allow-bash-check-all-ds-escape-hatch",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "pixi run python scripts/check-all-ds.sh" }
      }
    },
    {
      "name": "deny-bash-inline-python-analysis",
      "kind": "deny",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "python3 -c 'import pandas as pd; print(pd.read_parquet(\"data/raw/x.parquet\").head())'" }
      }
    },
    {
      "name": "allow-bash-unmatched-command",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "rg --files data/" }
      }
    },
    {
      "name": "allow-write-planning-path",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": ".planning/SPEC.md", "content": "# spec" }
      }
    },
    {
      "name": "allow-write-scripts-python-exempt",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": "scripts/build_panel.py", "content": "x = 1" }
      }
    },
    {
      "name": "deny-write-analysis-python",
      "kind": "deny",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": "src/build_panel.py", "content": "import pandas" }
      }
    },
    {
      "name": "deny-edit-analysis-notebook",
      "kind": "deny",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": { "file_path": "notebooks/explore.ipynb", "old_string": "a", "new_string": "b" }
      }
    },
    {
      "name": "allow-write-non-analysis-extension",
      "kind": "allow",
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": "docs/investigations/2026-07-29_topic.md", "content": "# notes" }
      }
    }
  ]
}
